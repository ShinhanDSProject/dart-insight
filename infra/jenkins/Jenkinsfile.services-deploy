pipeline {
    agent { label 'dart-builder' }

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(
            name: 'AI_IMAGE_TAG',
            defaultValue: 'eb913562aa918a5d5367b763803eb2583fd3ccd7',
            description: 'AI 이미지의 전체 커밋 번호'
        )
        string(
            name: 'BACKEND_IMAGE_TAG',
            defaultValue: 'eb913562aa918a5d5367b763803eb2583fd3ccd7',
            description: '백엔드 이미지의 전체 커밋 번호'
        )
    }

    stages {
        stage('AI 및 백엔드 배포') {
            steps {
                script {
                    env.AI_IMAGE_TAG = params.AI_IMAGE_TAG ?:
                        'eb913562aa918a5d5367b763803eb2583fd3ccd7'

                    env.BACKEND_IMAGE_TAG = params.BACKEND_IMAGE_TAG ?:
                        'eb913562aa918a5d5367b763803eb2583fd3ccd7'
                }

                sh '''
                    bash /home/jenkins/agent/ops/deploy-ai-backend.sh \
                      "$AI_IMAGE_TAG" "$BACKEND_IMAGE_TAG"
                '''
            }
        }
    }
}