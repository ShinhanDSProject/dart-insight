pipeline {
    agent none

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipStagesAfterUnstable()
    }

    // 1분마다 main의 새 커밋을 확인한다(이전 5분). 확인은 git ls-remote 한 번이라 가볍다
    triggers { pollSCM('* * * * *') }

    stages {
        stage('검사와 실행 이미지 생성') {
            agent { label 'dart-builder' }

            stages {
                stage('GitHub 소스 가져오기') {
                    steps {
                        script {
                            def scmVars = checkout(
                                changelog: true,
                                poll: true,
                                scm: [
                                    $class: 'GitSCM',
                                    branches: [[name: '*/main']],
                                    userRemoteConfigs: [[
                                        name: 'origin',
                                        url: 'https://github.com/ShinhanDSProject/dart-insight.git',
                                        refspec: '+refs/heads/main:refs/remotes/origin/main'
                                    ]],
                                    extensions: [[
                                        $class: 'CloneOption',
                                        shallow: false,
                                        noTags: true,
                                        honorRefspec: true,
                                        timeout: 10
                                    ]]
                                ]
                            )

                            env.RELEASE_SHA = sh(
                                script: 'git rev-parse HEAD',
                                returnStdout: true
                            ).trim()

                            // 지난 성공 빌드 이후 바뀐 서비스만 검사·이미지 생성·배포한다.
                            // 이전 기록이 없거나, 같은 커밋을 다시 돌리거나, infra/가 바뀌면 전부 한다.
                            def base = scmVars.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: ''
                            def changed = []
                            if (base && sh(script: "git cat-file -e ${base}^{commit}", returnStatus: true) == 0) {
                                def out = sh(
                                    script: "git diff --name-only --no-renames ${base} ${env.RELEASE_SHA}", // 옮긴 파일은 원래 경로와 새 경로를 둘 다 본다
                                    returnStdout: true
                                ).trim()
                                if (out) {
                                    for (String path : out.split('\n')) {
                                        changed.add(path)
                                    }
                                }
                            }
                            boolean all = !base || changed.isEmpty()
                            boolean backend = false
                            boolean frontend = false
                            boolean ai = false
                            for (String path : changed) {
                                if (path.startsWith('infra/')) { all = true }
                                if (path.startsWith('backend/')) { backend = true }
                                if (path.startsWith('frontend/')) { frontend = true }
                                if (path.startsWith('ai-server/')) { ai = true }
                            }
                            env.RUN_BACKEND = (all || backend) ? 'true' : 'false'
                            env.RUN_FRONTEND = (all || frontend) ? 'true' : 'false'
                            env.RUN_AI = (all || ai) ? 'true' : 'false'
                            // AI와 백엔드는 배포 작업 하나로 함께 교체하므로 둘 중 하나라도 바뀌면 둘 다 만든다
                            env.DEPLOY_SERVICES = (env.RUN_BACKEND == 'true' || env.RUN_AI == 'true') ? 'true' : 'false'
                            echo "기준 커밋: ${base ?: '(없음)'} · 바뀐 파일 ${changed.size()}개 · 전체 실행: ${all}"
                            echo "백엔드: ${env.RUN_BACKEND} · 프론트엔드: ${env.RUN_FRONTEND} · AI: ${env.RUN_AI} · AI·백엔드 배포: ${env.DEPLOY_SERVICES}"
                        }

                        sh 'git log -1 --oneline'
                    }
                }

                stage('배포 사전 검사 검증') {
                    steps {
                        sh '''#!/usr/bin/env bash
set -euo pipefail
docker build --progress=plain -f - ./infra/jenkins <<'DOCKERFILE'
FROM python:3.12-slim
WORKDIR /checks
COPY deploy-ai-backend.sh ./
COPY tests/test_migration_preflight.py ./tests/
RUN python tests/test_migration_preflight.py
DOCKERFILE
'''
                    }
                }

                stage('백엔드 빌드와 테스트') {
                    when { expression { env.RUN_BACKEND == 'true' } }
                    steps {
                        sh '''#!/usr/bin/env bash
set -euo pipefail

docker build --progress=plain \
  -t "dart-ci-backend:${BUILD_NUMBER}" \
  -f - ./backend <<'DOCKERFILE'
FROM eclipse-temurin:21-jdk
WORKDIR /app
COPY . .
DOCKERFILE

docker run --rm \
  --memory 3g \
  --cpus 1.0 \
  -v dart_ci_gradle_cache:/root/.gradle \
  "dart-ci-backend:${BUILD_NUMBER}" \
  bash ./gradlew \
    --no-daemon \
    --max-workers=1 \
    --build-cache \
    -Dorg.gradle.jvmargs=-Xmx1536m \
    build
'''
                    }
                }

                stage('프론트엔드 검사와 빌드') {
                    when { expression { env.RUN_FRONTEND == 'true' } }
                    steps {
                        sh '''#!/usr/bin/env bash
set -euo pipefail

docker build --progress=plain \
  -t "dart-ci-frontend:${BUILD_NUMBER}" \
  -f - ./frontend <<'DOCKERFILE'
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV VITE_API_BASE_URL=""
DOCKERFILE

docker run --rm \
  --memory 2g \
  --cpus 1.0 \
  "dart-ci-frontend:${BUILD_NUMBER}" \
  sh -c '
    set -eu
    npm run lint
    npm test -- --maxWorkers=1
    npm run build
  '
'''
                    }
                }

                stage('AI 서버 검사와 테스트') {
                    when { expression { env.RUN_AI == 'true' } }
                    steps {
                        sh '''#!/usr/bin/env bash
set -euo pipefail

docker build --progress=plain \
  -t "dart-ci-ai:${BUILD_NUMBER}" \
  -f - ./ai-server <<'DOCKERFILE'
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-dev.txt ./
RUN python -m pip install --no-cache-dir \
    -r requirements.txt -r requirements-dev.txt
COPY . .
DOCKERFILE

docker run --rm \
  --memory 2g \
  --cpus 1.0 \
  "dart-ci-ai:${BUILD_NUMBER}" \
  sh -c '
    set -eu
    ruff check .
    pytest
  '
'''
                    }
                }

                stage('커밋 버전 실행 이미지 생성') {
                    when { expression { env.DEPLOY_SERVICES == 'true' || env.RUN_FRONTEND == 'true' } }
                    steps {
                        sh '''#!/usr/bin/env bash
set -euo pipefail

[[ "$RELEASE_SHA" =~ ^[0-9a-f]{40}$ ]]

test -f backend/Dockerfile
test -f frontend/Dockerfile
test -f ai-server/Dockerfile

# Git에 기록된 파일만 별도 폴더에 추출한다.
build_root=$(mktemp -d)
trap 'rm -rf -- "$build_root"' EXIT

git archive "$RELEASE_SHA" |
  tar -x -C "$build_root"

if [[ "$DEPLOY_SERVICES" == true ]]; then
  docker build --progress=plain \
    --label "org.opencontainers.image.revision=$RELEASE_SHA" \
    -t "dart-insight-backend:$RELEASE_SHA" \
    "$build_root/backend"

  docker build --progress=plain \
    --label "org.opencontainers.image.revision=$RELEASE_SHA" \
    -t "dart-insight-ai:$RELEASE_SHA" \
    "$build_root/ai-server"
fi

if [[ "$RUN_FRONTEND" == true ]]; then
  docker build --progress=plain \
    --label "org.opencontainers.image.revision=$RELEASE_SHA" \
    -t "dart-insight-web:$RELEASE_SHA" \
    "$build_root/frontend"
fi

bash -n infra/jenkins/deploy-ai-backend.sh
install -d -m 700 /home/jenkins/agent/ops
install -m 700 infra/jenkins/deploy-ai-backend.sh \
  /home/jenkins/agent/ops/deploy-ai-backend.sh

echo "실행 이미지 생성 완료: $RELEASE_SHA"
'''
                    }
                }
            }

            post {
                always {
                    sh '''#!/usr/bin/env bash
docker image rm \
  "dart-ci-backend:${BUILD_NUMBER}" \
  "dart-ci-frontend:${BUILD_NUMBER}" \
  "dart-ci-ai:${BUILD_NUMBER}" || true
'''
                }
            }
        }

        stage('AI와 백엔드 배포') {
            when { expression { env.DEPLOY_SERVICES == 'true' } }
            steps {
                build job: 'dart-services-deploy',
                    wait: true,
                    propagate: true,
                    parameters: [
                        string(
                            name: 'AI_IMAGE_TAG',
                            value: env.RELEASE_SHA
                        ),
                        string(
                            name: 'BACKEND_IMAGE_TAG',
                            value: env.RELEASE_SHA
                        )
                    ]
            }
        }

        stage('웹 배포') {
            when { expression { env.RUN_FRONTEND == 'true' } }
            steps {
                build job: 'dart-web-deploy',
                    wait: true,
                    propagate: true,
                    parameters: [
                        string(
                            name: 'WEB_IMAGE_TAG',
                            value: env.RELEASE_SHA
                        )
                    ]
            }
        }
    }
}