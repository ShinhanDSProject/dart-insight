# 실제 값은 서버에만 입력하고 Git에 올리지 않습니다.
# LLM 제공자·모델은 이 파일에서만 정합니다(compose.ai.yaml에 적지 않음). 팀 결정은 anthropic / claude-haiku-5-5(ADR-0062·0063).
# 키는 제공자에 맞는 것을 넣습니다(anthropic이면 Anthropic Console의 API 키).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_API_KEY=replace-with-your-value

# AI Compose 바인딩 주소: 서버의 실제 내부 주소를 별도로 설정한다.
AI_BIND_ADDRESS=127.0.0.1
