# 실제 값은 서버에만 입력하고 Git에 올리지 않습니다.
DB_PASSWORD=replace-with-your-value
DB_ROOT_PASSWORD=replace-with-your-value
JWT_SECRET=replace-with-your-value
OPENDART_API_KEY=replace-with-your-value

# 뉴스 검색 인증 정보는 네이버 로그인 인증 정보와 별개입니다.
NAVER_SEARCH_CLIENT_ID=replace-with-your-value
NAVER_SEARCH_CLIENT_SECRET=replace-with-your-value

# 메일 발송과 비밀번호 재설정
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-your-value
MAIL_PASSWORD=replace-with-your-value
MAIL_FROM=replace-with-your-value
PASSWORD_RESET_PAGE_URL=https://dart-insight.shinhanacademy.co.kr/password-reset
PASSWORD_RESET_LOG_LINK=false

# 소셜 로그인
GOOGLE_CLIENT_ID=replace-with-your-value
GOOGLE_CLIENT_SECRET=replace-with-your-value
KAKAO_CLIENT_ID=replace-with-your-value
KAKAO_CLIENT_SECRET=replace-with-your-value
NAVER_CLIENT_ID=replace-with-your-value
NAVER_CLIENT_SECRET=replace-with-your-value

# 실제 AI 서버 주소는 서버에서 입력합니다. 아래 주소는 실행용이 아닌 예시입니다.
AI_SERVER_URL=http://ai-server.example.invalid:8000
AI_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
