# ai-server(FastAPI) 환경변수 예시
# 이 파일을 복사해 .env를 만들고 값을 채웁니다: cp .env.example .env
# .env는 커밋하지 않습니다. 이 파일에는 변수 이름과 가짜 값만 둡니다.
# 실행: uvicorn app.main:app --reload --port 8000 --env-file .env
# 2~4절은 아직 코드가 읽지 않는 자리 표시입니다. 기능을 만들면서 확정합니다.

# ── 1. LLM (0.7 LLM 호출 모듈) ───────────────────────────
# 제공자: fake(테스트·개발용 가짜 응답) 또는 openai(OpenAI Responses API, ADR-0026).
# 비워 두면 LLM을 쓰지 않고, 요약이 필요한 분석은 '실패'로 끝납니다.
LLM_PROVIDER=fake
LLM_MODEL=fake-model
# OpenAI를 쓸 때는 위 두 줄 대신 아래 주석을 풀고, LLM_API_KEY에 본인 키를 넣습니다.
# LLM_MODEL을 비우면 gpt-6.1-sol을 씁니다. 다른 모델 ID로 바꿔도 됩니다.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-6.1-sol
# 실제 제공자를 쓸 때만 채웁니다. 개인 키를 공유하지 않습니다.
LLM_API_KEY=your-llm-api-key
# 추론 강도(선택). 비우면 모델 기본값(gpt-6.1-sol은 medium). gpt-6.1-sol: low·medium·high·xhigh·max
# LLM_REASONING_EFFORT=medium
# 한 번 호출의 응답 대기 시간(초), 일시 오류 재시도 횟수, 결과 검증 실패 시 다시 생성하는 횟수(최대 2)
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_MAX_OUTPUT_RETRIES=2
# 요청 하나(재시도·다시 생성 포함)에 쓰는 전체 시간(초). backend의 AI 서버 대기 시간(180초)보다 짧게 둡니다.
# LLM_TOTAL_TIMEOUT_SECONDS=120

# ── 2. 임베딩·벡터 DB ────────────────────────────────────
# 기본 임베딩 모델(프로젝트 개요 6장). 로컬에서 내려받아 씁니다.
EMBEDDING_MODEL=nlpai-lab/KURE-v1
# Chroma는 서버를 따로 띄우지 않고, ai-server가 이 폴더에 파일로 저장합니다(4.2·2.5에서 확정).
CHROMA_PERSIST_DIR=.cache/chroma

# ── 3. 원문 캐시 ─────────────────────────────────────────
# 내려받은 원문 ZIP과 파싱 결과를 접수번호별로 저장하는 위치
DART_CACHE_DIR=.cache/dart

# ── 4. OpenDART (선택) ───────────────────────────────────
# ai-server 코드는 이 값을 읽지 않습니다. OpenDART는 backend만 부르고, 키는 backend/.env에 넣습니다.
# 원문 파싱 스파이크처럼 ai-server에서 따로 받아 볼 때만 주석을 풉니다.
# OPENDART_API_KEY=your-opendart-api-key

# ── 5. 서버 ──────────────────────────────────────────────
# 포트는 실행할 때 정합니다: uvicorn app.main:app --port 8000 (기본 8000).
# 바꾸면 backend의 AI_SERVER_URL도 같이 바꿉니다.
