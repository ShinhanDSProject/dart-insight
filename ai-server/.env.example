# ai-server(FastAPI) 환경변수 예시
# 이 파일을 복사해 .env를 만들고 값을 채웁니다: cp .env.example .env
# .env는 커밋하지 않습니다. 이 파일에는 변수 이름과 가짜 값만 둡니다.
# 변수 이름과 기본값은 FastAPI 프로젝트를 만들면서 확정합니다.

# ── 1. LLM ───────────────────────────────────────────────
# LLM 제공자와 모델은 팀이 정한 뒤 이름을 확정합니다.
LLM_API_KEY=your-llm-api-key
LLM_MODEL=model-name

# ── 2. 임베딩·벡터 DB ────────────────────────────────────
# 기본 임베딩 모델(프로젝트 개요 6장). 로컬에서 내려받아 씁니다.
EMBEDDING_MODEL=nlpai-lab/KURE-v1
# Chroma 서버 주소. 저장소 루트의 compose.yaml로 띄운 Chroma(8001)를 씁니다.
CHROMA_URL=http://localhost:8001

# ── 3. 원문 캐시 ─────────────────────────────────────────
# 내려받은 원문 ZIP과 파싱 결과를 접수번호별로 저장하는 위치
DART_CACHE_DIR=.cache/dart

# ── 4. OpenDART (선택) ───────────────────────────────────
# 정식 흐름에서는 backend가 OpenDART를 부릅니다.
# 원문 파싱 스파이크처럼 ai-server에서 직접 받을 때만 주석을 풉니다.
# OPENDART_API_KEY=your-opendart-api-key

# ── 5. 서버 (선택) ───────────────────────────────────────
# 기본값은 8000입니다. backend의 AI_SERVER_URL과 맞춥니다.
# PORT=8000
