<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  backend 최소 Checkstyle 규칙(이슈 #164). 판단 없이 기계로 가릴 수 있는 것만 둔다.
  줄 길이·Javadoc·들여쓰기 같은 형식은 포매터 결정 뒤에 따로 정한다.
  참고: shinhan-delivery config/checkstyle/checkstyle.xml
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="TreeWalker">
    <!-- import: * 금지, 쓰지 않거나 겹치는 import 금지 -->
    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>

    <!-- 이름: 타입은 UpperCamelCase, 메서드·변수는 lowerCamelCase(언더스코어 금지) -->
    <module name="TypeName">
      <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
    </module>
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <!-- static final 상수는 UPPER_SNAKE_CASE(로거·serialVersionUID 제외) -->
    <module name="ConstantName">
      <property name="format" value="^([A-Z][A-Z0-9]*(_[A-Z0-9]+)*|log|logger|serialVersionUID)$"/>
    </module>
    <module name="MemberName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="LocalVariableName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="ParameterName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>

    <!-- 엔티티 상태는 static 팩터리와 도메인 메서드로만 바꾼다(conventions.yaml EN-1). 상태를 밖에서 바꾸거나 전부 받는 Lombok은 쓰지 않는다 -->
    <module name="IllegalImport">
      <property name="illegalClasses" value="lombok.Setter, lombok.Builder, lombok.Data, lombok.Value, lombok.AllArgsConstructor"/>
    </module>

    <!-- 코드 본문에 우리 클래스 전체 경로(com.dartinsight.…) 표기 금지. package·import 줄과 주석(Javadoc 포함)은 제외 -->
    <module name="RegexpSinglelineJava">
      <property name="format" value="^(?!\s*(package|import)\s).*\bcom\.dartinsight\.[a-zA-Z0-9_]+\."/>
      <property name="message" value="코드 본문에 우리 클래스의 전체 경로가 있습니다. import로 가져와 쓰세요."/>
      <property name="ignoreComments" value="true"/>
    </module>
  </module>
</module>
