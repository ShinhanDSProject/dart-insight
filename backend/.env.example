# backend(Spring Boot) 환경변수 예시
# 이 파일을 복사해 .env를 만들고 값을 채웁니다: cp .env.example .env
# .env는 커밋하지 않습니다. 이 파일에는 변수 이름과 가짜 값만 둡니다.
# application.yml이 ${변수명}으로 읽습니다. 주석으로 둔 변수는 application.yml의 기본값을 씁니다.

# ── 1. OpenDART ──────────────────────────────────────────
# OpenDART 인증키(40자리). 개발할 때는 팀 공용 키 하나를 씁니다.
# 이 파일의 공용 키 값은 팀 노션 '공용 키 모음' 한 곳에 있습니다.
# 실제 값은 .env에만 넣고, 이 파일·커밋·PR·채팅에는 쓰지 않습니다.
OPENDART_API_KEY=your-opendart-api-key
# 서버를 시작할 때 기업 목록(corpCode.xml)을 받을지: on-empty(비어 있을 때만, 기본), always, never
# OPENDART_CORP_CODE_SYNC=on-empty

# ── 2. DB (MariaDB) ──────────────────────────────────────
# 로컬 MariaDB 접속 정보. 기본 포트는 3306입니다.
DB_URL=jdbc:mariadb://localhost:3306/dart_insight
DB_USERNAME=dart
DB_PASSWORD=change-me

# ── 3. AI 서버 ───────────────────────────────────────────
# FastAPI 주소. ai-server를 로컬에서 띄운 포트와 맞춥니다.
AI_SERVER_URL=http://localhost:8000

# ── 4. 원문 캐시 (선택) ──────────────────────────────────
# 받은 원문 ZIP(공시서류원본파일)을 두는 폴더. 기본값은 ./data/documents입니다(커밋하지 않음).
# DOCUMENT_CACHE_DIR=./data/documents

# ── 5. 서버 (선택) ───────────────────────────────────────
# 기본값은 8080입니다. 바꿀 때만 주석을 풉니다.
# SERVER_PORT=8080
# 화면(React) 주소. 여러 개면 쉼표로 구분합니다. 기본값은 http://localhost:5173입니다.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 6. 일반 로그인 ───────────────────────────────────────
# 운영 환경에서는 예측 불가능한 32바이트 이상의 값을 사용합니다. 실제 값은 .env에만 둡니다.
JWT_SECRET=development-only-change-me-32-bytes
# JWT_ISSUER=dart-insight
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=14d
# 운영 HTTPS 환경에서는 true로 설정합니다.
# AUTH_SECURE_COOKIE=false

# ── 6.3 소셜 로그인 ──────────────────────────────────────
# 실제 값은 각 제공자 개발자 콘솔에서 발급받아 backend/.env에만 넣습니다.
GOOGLE_CLIENT_ID=development-google-client
GOOGLE_CLIENT_SECRET=development-google-secret
KAKAO_CLIENT_ID=development-kakao-client
KAKAO_CLIENT_SECRET=development-kakao-secret
NAVER_CLIENT_ID=development-naver-client
NAVER_CLIENT_SECRET=development-naver-secret
# SOCIAL_LOGIN_REDIRECT_URL=http://localhost:5173/login
