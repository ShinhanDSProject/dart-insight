# backend(Spring Boot) 환경변수 예시
# 이 파일을 복사해 .env를 만들고 값을 채웁니다: cp .env.example .env
# .env는 커밋하지 않습니다. 이 파일에는 변수 이름과 가짜 값만 둡니다.
# application.yml이 ${변수명}으로 읽습니다. 주석으로 둔 변수는 application.yml의 기본값을 씁니다.

# ── 1. OpenDART ──────────────────────────────────────────
# OpenDART 인증키(40자리). 개발할 때는 팀 공용 키 하나를 씁니다.
# 이 파일의 공용 키 값은 팀 노션 '공용 키 모음' 한 곳에 있습니다.
# 실제 값은 .env에만 넣고, 이 파일·커밋·PR·채팅에는 쓰지 않습니다.
OPENDART_API_KEY=your-opendart-api-key
# 서버를 시작할 때 기업 목록(corpCode.xml)을 받을지: on-empty(비어 있을 때만, 기본), always, never
# OPENDART_CORP_CODE_SYNC=on-empty

# ── 2. DB (MariaDB) ──────────────────────────────────────
# 로컬 MariaDB 접속 정보. 기본 포트는 3306입니다.
DB_URL=jdbc:mariadb://localhost:3306/dart_insight
DB_USERNAME=dart
DB_PASSWORD=change-me

# ── 3. AI 서버 ───────────────────────────────────────────
# FastAPI 주소. ai-server를 로컬에서 띄운 포트와 맞춥니다.
AI_SERVER_URL=http://localhost:8000
AI_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

# ── 4. 원문 캐시 (선택) ──────────────────────────────────
# 받은 원문 ZIP(공시서류원본파일)을 두는 폴더. 기본값은 ./data/documents입니다(커밋하지 않음).
# DOCUMENT_CACHE_DIR=./data/documents

# ── 5. 서버 (선택) ───────────────────────────────────────
# 기본값은 8080입니다. 바꿀 때만 주석을 풉니다.
# SERVER_PORT=8080
# 화면(React) 주소. 여러 개면 쉼표로 구분합니다. 기본값은 http://localhost:5173입니다.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── 6. 일반 로그인 ───────────────────────────────────────
# 운영 환경에서는 예측 불가능한 32바이트 이상의 값을 사용합니다. 실제 값은 .env에만 둡니다.
JWT_SECRET=development-only-change-me-32-bytes
# JWT_ISSUER=dart-insight
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=14d
# 운영 HTTPS 환경에서는 true로 설정합니다.
# AUTH_SECURE_COOKIE=false
# 로그인할 때 관리자로 올릴 이메일(쉼표로 구분, ADR-0040). 소유가 확인된 이메일(예: Google 로그인)만 대조합니다.
# 실제 이메일은 .env·서버 환경변수에만 둡니다. 비워 두면 아무도 관리자가 되지 않습니다.
# ADMIN_EMAILS=admin@example.com

# ── 6.3 소셜 로그인 ──────────────────────────────────────
# 실제 값은 각 제공자 개발자 콘솔에서 발급받아 backend/.env에만 넣습니다.
GOOGLE_CLIENT_ID=development-google-client
GOOGLE_CLIENT_SECRET=development-google-secret
KAKAO_CLIENT_ID=development-kakao-client
KAKAO_CLIENT_SECRET=development-kakao-secret
NAVER_CLIENT_ID=development-naver-client
NAVER_CLIENT_SECRET=development-naver-secret
# SOCIAL_LOGIN_REDIRECT_URL=http://localhost:5173/login

# ── 7. 공공데이터포털 (첫 화면 대표 기업, 1.5) ──────────────
# '금융위원회_주식시세정보' 일반 인증키. data.go.kr 마이페이지 > 데이터 활용 > Open API에서 확인합니다.
# 포털 화면의 키를 그대로 넣습니다(인코딩된 모양이어도 됨). 없으면 대표 기업 칸만 비고 나머지는 그대로 동작합니다.
DATA_GO_KR_API_KEY=your-data-go-kr-service-key
# 시작할 때와 하루마다 목록이 오래됐으면(30일) 받을지: on-stale(기본), never
# FEATURED_COMPANY_SYNC=on-stale

# ── 8. 기업 뉴스 (NAVER API HUB 뉴스 검색, #592, ADR-0046) ──────────────
# 네이버 클라우드 콘솔 > NAVER API HUB > Application > 인증 정보의 Client ID·Secret. 소셜 로그인 키와 다릅니다.
# 없으면 뉴스 탭만 '불러오지 못함'이고 나머지는 그대로 동작합니다.
NAVER_SEARCH_CLIENT_ID=your-naver-search-client-id
NAVER_SEARCH_CLIENT_SECRET=your-naver-search-client-secret

# ── 9. 주요 사건 (3.36, ADR-0050) ───────────────────────
# 문장 변화 탭의 주요 사건 만들기. 7.7 검증을 통과하기 전에는 false로 둡니다.
TEXT_EVENTS_ENABLED=false

# ── 10. 비밀번호 재설정 메일 (6.8, ADR-0055) ─────────────
# 비워 두면 메일을 보내지 않습니다. 로컬 개발에서 링크를 서버 로그로 보려면 아래 PASSWORD_RESET_LOG_LINK를 true로 둡니다.
# Gmail로 보낼 때: MAIL_HOST=smtp.gmail.com, MAIL_USERNAME=팀 Gmail 주소, MAIL_PASSWORD=그 계정의 앱 비밀번호(16자리).
# 앱 비밀번호 원본은 팀 노션 '공용 키 모음'에만 둡니다.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-team-account@gmail.com
# MAIL_PASSWORD=your-gmail-app-password
# MAIL_FROM=
# 메일 링크가 여는 화면. 배포 서버는 https://{도메인}/password-reset
# PASSWORD_RESET_PAGE_URL=http://localhost:5173/password-reset
# 로컬 개발 전용: 메일 설정이 없을 때 재설정 링크(토큰 포함)를 서버 로그에 남깁니다. 배포 서버에는 넣지 않습니다.
PASSWORD_RESET_LOG_LINK=true
